#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D kOutputImage;

layout(push_constant) uniform TextureParameters {
    float time;
} pc;

const float Tau = 6.28318530718;

// 改编自 ShaderToy MdlXz8：少量迭代生成会流动的蓝色等值纹理。
vec3 proceduralColor(vec2 uv) {
    const vec2 p = mod(uv * Tau, Tau) - 250.0;
    vec2 value = p;
    float sum = 1.0;
    const float intensity = 0.005;
    const float time = pc.time * 0.5 + 23.0;

    for (int iteration = 0; iteration < 5; ++iteration) {
        const float t = time * (1.0 - 3.5 / float(iteration + 1));
        value = p + vec2(
            cos(t - value.x) + sin(t + value.y),
            sin(t - value.y) + cos(t + value.x));
        sum += 1.0 / length(vec2(
            p.x / (sin(value.x + t) / intensity),
            p.y / (cos(value.y + t) / intensity)));
    }

    sum = 1.17 - pow(sum / 5.0, 1.4);
    return clamp(vec3(pow(abs(sum), 8.0)) + vec3(0.0, 0.35, 0.5), 0.0, 1.0);
}

void main() {
    const ivec2 size = imageSize(kOutputImage);
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    imageStore(kOutputImage, pixel, vec4(proceduralColor(uv), 1.0));
}
